        <!-- ═══════════════════════════════════════════════════════════
             FLOW STEP NUMBERS SUMMARY BOX
             ═══════════════════════════════════════════════════════════ -->
        <mxCell id="flow-summary" value="Data Flow Steps:&#xa;① User/Agent HTTPS to Front Door&#xa;② WAF inspect + route to App GW&#xa;③ TLS offload → Container Apps&#xa;④ MSAL auth → Entra ID&#xa;⑤ Web UI → APIM (Private EP)&#xa;⑥ APIM → Azure Functions&#xa;⑦ Functions → Cosmos DB&#xa;⑧ Functions → Orchestration Engine&#xa;⑨ Orchestration → MCP Gateway&#xa;⑩ Resolve Agent from Registry&#xa;⑪ Publish to Event Hubs&#xa;⑫ MCP Gateway → AI Foundry (PE)&#xa;⑬ Orchestration → Azure OpenAI (PE)&#xa;⑭ Foundry → OpenAI Model API&#xa;⑮ Response → Content Safety&#xa;⑯ RAG Retrieval from AI Search&#xa;⑰ Publisher → Service Bus (async)&#xa;⑱ HITL Gate for approvals&#xa;⑲ All services → App Insights&#xa;⑳ Aggregate → Log Analytics&#xa;㉑ Managed Identity → Key Vault&#xa;㉒ CI/CD → Container Registry" style="text;html=1;strokeColor=#666666;fillColor=#fffde7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="20" y="1020" width="170" height="440" as="geometry" />
        </mxCell>

      </root>
